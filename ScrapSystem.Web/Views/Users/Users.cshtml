@model IEnumerable<ScrapSystem.Web.Models.Users>

<div class="row mb-3 align-items-center">
    <div class="col-md-3">
        <input type="text" id="txtSearch" class="form-control" placeholder="Search UserID / Section" />
    </div>

    <div class="col-md-auto">
        <button class="btn btn-primary" id="btnSearch">Search</button>
    </div>

    <div class="col-md-auto">
        <button class="btn btn-success" id="btnAdd">Add User</button>
    </div>

    <div class="col text-end">
        <button class="btn btn-sm btn-secondary" id="btnUpload">
            <i class="fa fa-upload"></i> Upload Excel
        </button>
        <button class="btn btn-sm btn-primary" id="btnExport">
            <i class="fa fa-download"></i> Export Excel
        </button>
    </div>
</div>

<!-- DÒNG MỚI -->
<div class="row mb-3">
    <div class="col-md-2">
        <select id="ddlPageSize" class="form-select">
            <option value="5" selected>5 / page</option>
            <option value="10">10 / page</option>
            <option value="20">20 / page</option>
            <option value="50">50 / page</option>
        </select>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>UserID</th>
            <th>Section</th>
            <th width="150">Action</th>
        </tr>
    </thead>
    <tbody id="usersBody">
        <!-- AJAX render -->
    </tbody>
</table>

<nav>
    <ul class="pagination" id="pager"></ul>
</nav>

<div class="modal fade" id="uploadModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Upload Users Excel</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="uploadForm" enctype="multipart/form-data">
                    <input type="file" name="file" class="form-control" accept=".xlsx" />
                    <button type="submit" class="btn btn-success mt-3">
                        Upload
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="usersModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">User</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        $('#btnUpload').click(function () {
            $('#uploadModal').modal('show');
        });

        $('#uploadForm').submit(function (e) {
            e.preventDefault();

            var formData = new FormData(this);

            $.ajax({
                url: '@Url.Action("UploadExcel", "Users")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        alert('Upload success: ' + res.count + ' users');
                        $('#uploadModal').modal('hide');
                        loadUsers(); // reload table
                    } else {
                        alert(res.message);
                    }
                }
            });
        });

                 $('#btnExport').click(function () {
            let keyword = $('#txtSearch').val() || '';

            // Gọi API trực tiếp, trình duyệt sẽ tải file
            window.location.href = '@Url.Action("ExportExcel", "Users")'
                                   + '?keyword=' + encodeURIComponent(keyword);
        });


    </script>

    <script>

        let page = 1;
        let pageSize = 5;
        let keyword = "";

        // ---------------- LOAD DATA ----------------
        function loadUsers() {
            $.get('@Url.Action("UsersList", "Users")', {
                keyword: keyword,
                page: page,
                pageSize: pageSize
            }, function (res) {

                let html = "";
                $.each(res.data, function (i, d) {
                            html += `
                                <tr id="row_${d.id}">
                                    <td>${d.id}</td>
                                    <td>${d.userID}</td>
                                    <td>${d.section ?? ""}</td>
                                    <td>
                                        <button class="btn btn-sm btn-info btn-detail" data-id="${d.id}">
                                            Detail
                                        </button>
                                        <button class="btn btn-sm btn-warning btn-edit" data-id="${d.id}">
                                            Edit
                                        </button>
                                        <button class="btn btn-sm btn-danger btn-delete" data-id="${d.id}">
                                            Delete
                                        </button>
                                    </td>
                                </tr>`;
                });

                $('#usersBody').html(html);
                renderPager(res.total);
            });
        }

        // ---------------- PAGING ----------------
        function renderPager(total) {
            let totalPages = Math.ceil(total / pageSize);
            let html = "";

            for (let i = 1; i <= totalPages; i++) {
                html += `
                    <li class="page-item ${i === page ? "active" : ""}">
                        <a href="#" class="page-link" data-page="${i}">${i}</a>
                    </li>`;
            }
            $('#pager').html(html);
        }

        // Click page
        $(document).on('click', '.page-link', function (e) {
            e.preventDefault();
            page = parseInt($(this).data('page'));
            loadUsers();
        });

        // ---------------- SEARCH ----------------
        $('#btnSearch').click(function () {
            keyword = $('#txtSearch').val();
            page = 1;
            loadUsers();
        });

        // CHANGE PAGESIZE
        $('#ddlPageSize').change(function () {
            pageSize = parseInt($(this).val());
            page = 1;
            loadUsers();
        });

        // ---------------- INIT ----------------
        $(function () {
            loadUsers();
        });

                // DETAIL
        $(document).on('click', '.btn-detail', function () {
            var id = $(this).data('id');

            $.get('@Url.Action("Details", "Users")', { id: id }, function (res) {
                $('#modalBody').html(res);
                $('#usersModal').modal('show');
            });
        });


        $(function () {
            $('#btnAdd').click(function () {
                $.get('@Url.Action("Create")', function(res){
                    $('#modalBody').html(res);
                    $('#usersModal').modal('show');
                    bindForm();
                });
            });

            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');

                $.get('@Url.Action("Edit", "Users")', { id: id }, function (res) {
                    $('#modalBody').html(res);
                    $('#usersModal').modal('show');
                    bindForm();
                });
            });

            $(document).on('click', '.btn-delete', function(){
                var id = $(this).data('id');
                if(confirm("Delete this user?")){
                    $.post('@Url.Action("Delete")', { id }, function(res){
                        if(res.success){
                            $('#row_' + id).remove();
                        }
                    });
                }
            });

            function bindForm(){
                $('#usersForm').off('submit').on('submit', function(e){
                    e.preventDefault();
                    var form = $(this);
                    $.ajax({
                        url: form.attr('action'),
                        type: 'POST',
                        data: form.serialize(),
                        success: function(res){
                            if(res.success){
                                $('#usersModal').modal('hide');
                                //location.reload();
                                loadUsers();
                            } else {
                                $('#modalBody').html(res);
                                bindForm();
                            }
                        }
                    });
                });
            }
        });
    </script>
}
