@model IEnumerable<ScrapSystem.Web.Models.MaterSection>

<h3>Mater Section</h3>

<div class="row mb-2 align-items-center">
    <div class="col-md-2">
        <input type="text" id="txtSearch" class="form-control" placeholder="Search section..." />
    </div>
    <div class="col-md-2">
        <input type="date" id="dateFrom" class="form-control" placeholder="From date" />
    </div>
    <div class="col-md-2">
        <input type="date" id="dateTo" class="form-control" placeholder="To date" />
    </div>
    <div class="col-md-auto">
        <button class="btn btn-primary" id="btnSearch">
            <i class="fa fa-search"></i> Search
        </button>
    </div>
    <div class="col-md-auto">
        <button class="btn btn-success" id="btnAdd">
            <i class="fa fa-plus"></i> Add
        </button>
    </div>
</div>


<table class="table table-bordered table-striped" id="tblMater">
    @* <thead class="table-dark"> *@
    <thead class="table-primary">
        <tr>
            <th>ID</th>
            <th>Section</th>
            <th>Description</th>
            <th>Flag</th>
            <th width="150">Action</th>
        </tr>
    </thead>
    @* //Bọc tbody để AJAX replace *@
    <tbody id="materBody">
        @foreach (var item in Model)
        {
            <tr id="row_@item.Id">
                <td>@item.Id</td>
                <td class="section">@item.Section</td>
                <td class="desc">@item.Description</td>
                <td class="flag">@item.Flag_del</td>
                <td>
                    <button class="btn btn-sm btn-info btn-detail" data-id="@item.Id">Detail</button>
                    <button class="btn btn-sm btn-warning btn-edit" data-id="@item.Id">Edit</button>
                    <button class="btn btn-sm btn-danger btn-delete" data-id="@item.Id">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination" id="pager"></ul>
</nav>

<!-- MODAL -->
<div class="modal fade" id="materModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Mater Section</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let page = 1;
        let pageSize = 10;
        let keyword = '';
        let typingTimer;

        // LOAD DATA FUNCTION
        function loadMater(keyword = '', dateFrom = '', dateTo = '') {
            $.get('@Url.Action("MaterSectionList")', {
                keyword: keyword,
                page: page,
                pageSize: pageSize,
                dateFrom: dateFrom,
                dateTo: dateTo
            }, function (res) {
                let html = '';
                $.each(res.data, function (i, d) {
                    html += `
                        <tr id="row_${d.id}">
                            <td>${d.id}</td>
                            <td class="section">${d.section}</td>
                            <td class="desc">${d.description ?? ''}</td>
                            <td class="flag">${d.flag_del}</td>
                            <td>
                                <button class="btn btn-sm btn-info btn-detail" data-id="${d.id}">Detail</button>
                                <button class="btn btn-sm btn-warning btn-edit" data-id="${d.id}">Edit</button>
                                <button class="btn btn-sm btn-danger btn-delete" data-id="${d.id}">Delete</button>
                            </td>
                        </tr>
                    `;
                });
                $('#materBody').html(html);
                renderPager(res.total);
            });
        }

        // DEBOUNCE SEARCH
        function doSearch() {
            clearTimeout(typingTimer);
            typingTimer = setTimeout(function () {
                page = 1;
                keyword = $('#txtSearch').val();
                let dateFrom = $('#dateFrom').val();
                let dateTo = $('#dateTo').val();
                loadMater(keyword, dateFrom, dateTo);
            }, 400);
        }

        // ENTER KEY PRESS
        $('#txtSearch').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                doSearch();
            }
        });

        // CLICK ICON SEARCH
        // $('#btnSearch').on('click', function () {
        //     doSearch();
        // });
        $('#btnSearch').click(function () {
            keyword = $('#txtSearch').val();
            page = 1;

            let dateFrom = $('#dateFrom').val();
            let dateTo = $('#dateTo').val();

            loadMater(keyword, dateFrom, dateTo);
        });


        // PAGING
        function renderPager(total) {
            let totalPages = Math.ceil(total / pageSize);
            let html = '';
            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${i === page ? 'active' : ''}">
                            <a href="#" class="page-link" data-page="${i}">${i}</a>
                         </li>`;
            }
            $('#pager').html(html);
        }

        $(document).on('click', '.page-link', function (e) {
            e.preventDefault();
            page = parseInt($(this).data('page'));
            loadMater();
        });

        $(function () {
             loadMater();  //load trang ngay luc dau 
            // =========================
            // ADD
            // =========================
            $('#btnAdd').click(function () {
                $.get('@Url.Action("CreateMaterSection")', function (res) {
                    $('#modalBody').html(res);
                    $('#materModal').modal('show');
                    bindForm();
                });
            });

            // =========================
            // EDIT
            // =========================
            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                $.get('@Url.Action("EditMaterSection")', { id: id }, function (res) {
                    $('#modalBody').html(res);
                    $('#materModal').modal('show');
                    bindForm();
                });
            });

            // =========================
            // DETAIL
            // =========================
            $(document).on('click', '.btn-detail', function () {
                var id = $(this).data('id');

                $.get('@Url.Action("MaterSectionDetail")', { id: id }, function (res) {
                    $('#modalBody').html(res);
                    $('#materModal').modal('show');
                });
            });

            // =========================
            // DELETE (SweetAlert confirm)
            // =========================
            $(document).on('click', '.btn-delete', function () {
                var id = $(this).data('id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'This record will be deleted!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: 'Delete'
                }).then((result) => {

                    if (!result.isConfirmed) return;

                    $.post('@Url.Action("DeleteMaterSection")', { id: id }, function (res) {
                        if (res.success) {
                            $('#row_' + res.id).remove();

                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Record deleted successfully',
                                timer: 1200,
                                showConfirmButton: false
                            });

                             loadMater();
                        }

                    });
                });
            });

            // =========================
            // AJAX SUBMIT FORM
            // =========================
            function bindForm() {
                $('#materForm').off('submit').on('submit', function (e) {
                    e.preventDefault();

                    var form = $(this);

                    $.ajax({
                        url: form.attr('action'),
                        type: 'POST',
                        data: form.serialize(),
                        success: function (res) {

                            // VALIDATION FAIL → trả lại partial
                            if (!res.success) {
                                $('#modalBody').html(res);
                                bindForm();
                                return;
                            }

                            var d = res.data;
                            var isEdit = $('#row_' + d.id).length > 0;

                            // ===== CREATE =====
                            if (!isEdit) {
                                $('#tblMater tbody').append(`
                                    <tr id="row_${d.id}">
                                        <td>${d.id}</td>
                                        <td class="section">${d.section}</td>
                                        <td class="desc">${d.description ?? ''}</td>
                                        <td class="flag">${d.flag_del}</td>
                                        <td>
                                            <button class="btn btn-sm btn-warning btn-edit" data-id="${d.id}">Edit</button>
                                            <button class="btn btn-sm btn-danger btn-delete" data-id="${d.id}">Delete</button>
                                        </td>
                                    </tr>
                                `);

                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Added successfully',
                                    showConfirmButton: false,
                                    timer: 1500
                                });
                                
                            }
                            // ===== EDIT =====
                            else {
                                var row = $('#row_' + d.id);
                                row.find('.section').text(d.section);
                                row.find('.desc').text(d.description);
                                row.find('.flag').text(d.flag_del);

                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Updated successfully',
                                    showConfirmButton: false,
                                    timer: 1500
                                });
                               
                            }
                             loadMater();
                            $('#materModal').modal('hide');
                        }
                    });
                });
            }
        });
    </script>
}
