@model ScrapSystem.Web.Models.MaterSection

<form id="materForm"
      asp-action="@(Model.Id == 0 ? "CreateMaterSection" : "EditMaterSection")">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Section</label>
        <input asp-for="Section" class="form-control" />
        <span asp-validation-for="Section" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Description</label>
        <input asp-for="Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Flag</label>
        <select asp-for="Flag_del" class="form-select">
            <option value="0">0</option>
            <option value="1">1</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
</form>

<partial name="_ValidationScriptsPartial" />

