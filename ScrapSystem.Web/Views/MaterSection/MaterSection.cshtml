@using ScrapSystem.Web.Models
@model IEnumerable<MaterSection> 

<h3>Mater Section</h3>

<form method="get">
    <div class="row mb-2">
        <div class="col-md-2">
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Search section..." />
        </div>
        <div class="col-md-2">
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <input type="date" name="dateTo" value="@ViewBag.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-auto">
            <button class="btn btn-primary" type="submit">Search</button>
        </div>
        @* <div class="col-md-auto">
            <a href="@Url.Action("CreateMaterSection")" class="btn btn-success">Add</a>
        </div> *@
        <div class="col-md-auto">
            <button type="button" id="btnAdd" class="btn btn-success">
                Add
            </button>
        </div>

    </div>
    <!-- DÒNG MỚI: Chọn số bản ghi / trang -->
    <div class="row mb-3">
        <div class="col-md-2 d-flex align-items-center">
            <label for="ddlPageSize" class="me-2 mb-0">PageSize:</label>
            @Html.DropDownList("ddlPageSize",
                        new SelectList(new int[] { 5, 10, 20, 50 }, ViewBag.PageSize),
                        htmlAttributes: new { @class = "form-select", id = "ddlPageSize" })
        </div>
    </div>


</form>


<!-- Bảng hiển thị dữ liệu -->
<table class="table table-bordered table-striped" id="tblMater">
    <thead class="table-primary">
        <tr>
            <th>#</th>
            <th>Section</th>
            <th>Description</th>
            <th>Flag</th>
            <th width="150">Action</th>
        </tr>
    </thead>
    <tbody id="materBody">
        @{
            int index = 1 + ((ViewBag.Page - 1) * ViewBag.PageSize);
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@index</td>
                <td>@item.Section</td>
                <td>@item.Description</td>
                <td>@item.Flag_del</td>
                <td>
                    <button class="btn btn-sm btn-info btn-detail" data-id="@item.Id">Detail</button>
                    <button class="btn btn-sm btn-warning btn-edit" data-id="@item.Id">Edit</button>
                    <button class="btn btn-sm btn-danger btn-delete" data-id="@item.Id">Delete</button>
                </td>
            </tr>
            index++;
        }
    </tbody>
</table>

<!-- Phân trang 1-->
