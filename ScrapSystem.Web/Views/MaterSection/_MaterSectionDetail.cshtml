@model ScrapSystem.Web.Models.MaterSection

<div class="container-fluid">
    <dl class="row">
        <dt class="col-sm-4">ID</dt>
        <dd class="col-sm-8">@Model.Id</dd>

        <dt class="col-sm-4">Section</dt>
        <dd class="col-sm-8">@Model.Section</dd>

        <dt class="col-sm-4">Description</dt>
        <dd class="col-sm-8">@Model.Description</dd>

        <dt class="col-sm-4">Flag</dt>
        <dd class="col-sm-8">@Model.Flag_del</dd>

        <dt class="col-sm-4">Create Date</dt>
        <dd class="col-sm-8">@Model.Createdate</dd>
    </dl>
</div>