﻿
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ScrapSystem</title>

    <script src="~/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet" href="~/css/font-awesome/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ti-icons/css/themify-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/feather/feather.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Sidebar cơ bản – nền sáng */
        .sidebar {
            width: 220px;
            min-height: 100vh;
            background: #f4f6f8; /* nền sáng */
            padding-top: 20px;
            transition: width 0.3s ease;
        }

            /* Menu cha */
            .sidebar .nav-link {
                color: #2c3e50; /* chữ menu cha tối */
                padding: 10px 20px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                transition: background 0.3s, color 0.3s;
            }

                /* Hover menu cha */
                .sidebar .nav-link:hover {
                    color: #1abc9c; /* nổi bật khi hover */
                    background: #e0f7fa; /* nền hover nhạt */
                    text-decoration: none;
                }

            /* Sub-menu */
            .sidebar .sub-menu {
                list-style: none; /* bỏ dấu chấm tròn */
                padding-left: 0; /* bỏ thụt lề mặc định */
                margin: 0; /* bỏ margin */
            }

                /* Menu con mặc định */
                .sidebar .sub-menu .nav-link {
                    color: #34495e; /* chữ menu con */
                    padding: 8px 20px; /* padding trên dưới và phải */
                    padding-left: 20px; /* căn lề trái bằng menu cha */
                    border-radius: 4px;
                    transition: background 0.3s, color 0.3s;
                    display: flex;
                    align-items: center;
                }

                    /* Hover menu con */
                    .sidebar .sub-menu .nav-link:hover {
                        background: #004d00; /* nền xanh lá cây đậm khi hover */
                        color: #a8ff60; /* chữ xanh lá sáng nổi bật */
                    }

                    /* Menu con active */
                    .sidebar .sub-menu .nav-link.active {
                        background: #007a00; /* nền xanh lá cây đậm hơn */
                        color: #ffffff; /* chữ trắng nổi bật */
                    }

            /* Arrow icon rotate khi mở */
            .sidebar .nav-item.open > .nav-link .menu-arrow {
                transform: rotate(180deg);
                transition: transform 0.3s ease;
            }

            /* Khi sidebar collapsed */
            .sidebar.collapsed {
                width: 60px; /* thu nhỏ sidebar */
            }

                .sidebar.collapsed .nav-link span {
                    display: none; /* ẩn chữ */
                }

                .sidebar.collapsed .menu-arrow {
                    display: none; /* ẩn mũi tên */
                }

                /* Đảm bảo các menu con khi collapsed không lệch */
                .sidebar.collapsed .sub-menu .nav-link {
                    padding-left: 10px; /* giảm padding trái khi sidebar thu nhỏ */
                }

    </style>

</head>

@{
                    var userId = Context.Session.GetString("UserID");
            //var section = Context.Session.GetString("Section");

            //var raw = $"{userId}|{section}";
            var raw = $"{userId}";
            var token = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(raw));
}

<body>
    <div class="container-scroller">
        <nav class="navbar col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
            <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
                <a class="navbar-brand brand-logo p-3" asp-action="Import" asp-controller="Scrap"><img src="~/Panasonic.svg" class="mr-2" alt="logo" /></a>
                <a class="navbar-brand brand-logo-mini"><img src="~/logo.png" alt="logo" /></a>
            </div>
            <div class="navbar-menu-wrapper d-flex align-items-center justify-content-end">
                <button id="sidebarToggle" class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <ul class="navbar-nav navbar-nav-right">
                    <li class="nav-item nav-profile dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown" id="profileDropdown">
                            <img src="~/search.svg" alt="profile" />
                        </a>
                        <div class="dropdown-menu dropdown-menu-right navbar-dropdown" aria-labelledby="profileDropdown">
                            <a class="dropdown-item">
                                <i class="ti-settings text-primary"></i>
                                Settings
                            </a>
                            <a class="dropdown-item" href="javascript:void(0);" onclick="document.getElementById('logoutForm').submit();">
                                <i class="ti-power-off text-primary"></i>
                                Logout
                            </a>
                            <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display:none;">
                                @Html.AntiForgeryToken()
                            </form>
                        </div>
                    </li>
                </ul>
                <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </nav>

        <!-- sidebar -->
        <div class="container-fluid page-body-wrapper">
            <!-- Sidebar -->
            <nav class="sidebar">
                <ul class="nav flex-column">
                    <!-- SCRAP MANAGEMENT -->
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#scrapGroup" role="button" aria-expanded="false" aria-controls="scrapGroup">
                            <span>Scrap Management</span>
                            <i class="fa fa-chevron-down menu-arrow"></i>
                        </a>
                        <div class="collapse" id="scrapGroup">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" asp-action="Index" asp-controller="Scrap">Label List</a></li>
                                <li class="nav-item"><a class="nav-link" asp-action="Import" asp-controller="Scrap">Import ScrapList</a></li>
                                <li class="nav-item"><a class="nav-link" href="http://localhost:61772/frmUploadScraplist.aspx?token=@token" target="_blank">Scrap List</a></li>
                                <li class="nav-item"><a class="nav-link" href="http://10.92.184.24:8096/frmConvertToll.aspx" target="_blank">Tool Convert</a></li>
                            </ul>
                        </div>
                    </li>
                    <!-- SETTING MATER -->
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#materGroup" role="button" aria-expanded="false" aria-controls="materGroup">
                            <span>Setting Mater</span>
                            <i class="fa fa-chevron-down menu-arrow"></i>
                        </a>
                        <div class="collapse" id="materGroup">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" href="http://10.92.184.24:8096/frmMaterialname.aspx" target="_blank">Material Name</a></li>
                                <li class="nav-item"><a class="nav-link" href="#" target="_blank">Material Vendor</a></li>
                                <li class="nav-item"><a class="nav-link" href="#" target="_blank">Material MVT</a></li>
                            </ul>
                        </div>
                    </li>
                    <!-- REPORT GROUP -->
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#reportGroup" role="button" aria-expanded="false" aria-controls="reportGroup">
                            <span>Reports</span>
                            <i class="fa fa-chevron-down menu-arrow"></i>
                        </a>
                        <div class="collapse" id="reportGroup">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" asp-action="Report" asp-controller="Scrap">Report</a></li>
                                <li class="nav-item"><a class="nav-link" href="http://10.92.184.24:8096/frmExportImage.aspx" target="_blank">Report Monthly</a></li>
                            </ul>
                        </div>
                    </li>
                    <!-- OTHERS -->
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#otherGroup" role="button" aria-expanded="false" aria-controls="otherGroup">
                            <span>Others</span>
                            <i class="fa fa-chevron-down menu-arrow"></i>
                        </a>
                        <div class="collapse" id="otherGroup">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"><a class="nav-link" asp-action="Documents" asp-controller="Scrap">Documents</a></li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </nav>

            <div class="main-panel">
                <div class="content-wrapper">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>

                <!-- partial -->
            </div>
        </div>
    </div>

    <script>
        document.getElementById('sidebarToggle').addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('collapsed');
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/template.js" asp-append-version="true"></script>
    <script src="~/js/settings.js" asp-append-version="true"></script>
    <script src="~/js/off-canvas.js" asp-append-version="true"></script>
    <script src="~/js/Vendors/vendor.bundle.base.js" asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>